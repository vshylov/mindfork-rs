[Desktop Entry]
Version=1.0
Type=Application
Name=mindfork
GenericName=AI Chat
GenericName[ru]=ИИ-чат
Comment=Console AI chat with local and cloud models
Comment[ru]=Консольный ИИ-чат с локальными и облачными моделями
Exec=mindfork
Icon=mindfork
# Mandatory: the app is a TUI, stdout is occupied by the interface. Without Terminal=true
# launching from the menu gives no terminal and the window closes instantly.
Terminal=true
# Utility — the primary category; ConsoleOnly flags the text interface.
# Chat is deliberately not taken: per the spec it requires the primary category Network,
# otherwise desktop-file-validate emits a warning.
Categories=Utility;ConsoleOnly;
Keywords=AI;LLM;chat;llama;gemma;qwen;openai;claude;gemini;TUI;terminal;
Keywords[ru]=ИИ;чат;нейросеть;модель;терминал;
StartupNotify=false
