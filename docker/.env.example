# Copy to `.env` next to compose.yaml and edit. Every value here is the default
# that compose.yaml falls back to, so an empty `.env` behaves identically.
# Background and the reasoning behind each knob: docs/research/docker-jupyter-env.md

# ── Ports on the host ─────────────────────────────────────────────────────────
# 8000/8001 are published on purpose: with them, `cargo test -- --ignored` runs
# from the Windows host against this stack (see docker/README.md §4).
LAB_PORT=8888
CHAT_PORT=8000
EMBED_PORT=8001

# JupyterLab sign-in token. The URL is http://localhost:8888/lab?token=<this>.
JUPYTER_TOKEN=mindfork

# ── Images ────────────────────────────────────────────────────────────────────
# The CPU build of llama.cpp's server. There is no `:latest` tag upstream; `:server`
# is the moving CPU tag. Digest verified 2026-08-26:
#   sha256:b9b2fa89baafb4e948a766562b70fd86202b570244ccc170556ea1332b61176a
# Append `@sha256:…` here to pin a build the way the project pins its toolchain.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
CURL_IMAGE=curlimages/curl:8.21.0

# ── Models ────────────────────────────────────────────────────────────────────
# Where the GGUFs live. A bare name is the named docker volume (default); an
# absolute or ./relative path turns the same mount into a bind mount of a host
# directory you already filled — compose decides by the shape of the value.
#   MODELS_DIR=D:/GGUF
MODELS_DIR=models

# Chat: Gemma 4 E2B instruct, Q8_0 — 4 967 497 184 B (4.63 GiB).
# For a tighter memory budget swap the quant to Q4_K_M (~2.7 GiB): change the
# file name here, the download follows. The size is re-read from the server on
# every run, so nothing else needs editing.
CHAT_REPO=bartowski/google_gemma-4-E2B-it-GGUF
CHAT_GGUF=google_gemma-4-E2B-it-Q8_0.gguf

# The vision projector that turns `/image attach` on (spec §9.10) —
# 985 653 760 B (940 MiB) of download and about as much RAM. Blank both this and
# CHAT_EXTRA_ARGS below to run the chat model text-only.
MMPROJ_GGUF=mmproj-google_gemma-4-E2B-it-f16.gguf

# Embeddings: the model the retrieval gates were calibrated on (tools/hf_api.py).
# Changing it changes the vector space — the app will notice and offer /reindex.
EMBED_REPO=ggml-org/bge-m3-Q8_0-GGUF
EMBED_GGUF=bge-m3-q8_0.gguf

# Set for a gated Hugging Face repository. Neither default model needs it.
HF_TOKEN=

# ── llama-server tuning ───────────────────────────────────────────────────────
# Context for the chat server. KV cache is the second-largest memory consumer
# after the weights; 8192 matches the example in docs/install.md §3.
CHAT_CTX=8192

# Extra flags appended verbatim to each server's command line. This is the single
# escape hatch for anything optional: the projector, `-t <threads>` (llama.cpp
# defaults to the physical core count), `--reasoning-format auto` for a thinking
# model, and so on.
CHAT_EXTRA_ARGS=--mmproj /models/mmproj-google_gemma-4-E2B-it-f16.gguf
EMBED_EXTRA_ARGS=

# ── The app ───────────────────────────────────────────────────────────────────
# Interface language and the scaffold language of new profiles (`defaults.json`
# `default_language`, docs/install.md §2.1): ru | en. Applied only while the data
# volume is still empty — afterwards the setting inside the app wins.
LAB_LANG=ru

# Host directory shown as `work/` in the JupyterLab file browser — the easy way
# to drop a file in for /file attach or /rag add.
WORK_DIR=./work

# Cloud keys, passed straight through to the app's process. Naming the variable
# is the documented alternative to typing a key into the settings screen
# (docs/install.md §3.1), and it is the right one here: the container's
# machine-id — and therefore any key stored the encrypted way — is regenerated
# whenever the lab image is rebuilt.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
