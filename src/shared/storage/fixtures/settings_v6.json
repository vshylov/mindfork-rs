{
  "schema_version": 6,
  "default_sampling": {
    "temperature": 0.75,
    "max_tokens": 16384,
    "reasoning_effort": "high",
    "thinking": true
  },
  "engine": {
    "mode": "external",
    "external": {
      "url": "https://api.deepseek.com/v1",
      "model_name": "deepseek-flash",
      "sessions": 1,
      "concurrent_calls": 1,
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "grok": {
      "model_name": "grok-4.5",
      "api_key_env": "XAI_API_KEY",
      "url": null,
      "sessions": 1,
      "concurrent_calls": 4
    }
  },
  "impersonation_engine": {
    "mode": "shared"
  },
  "self_model": {
    "max_narrative": 50,
    "narrative_in_prompt": 3,
    "prompt_cap": 4000
  }
}
